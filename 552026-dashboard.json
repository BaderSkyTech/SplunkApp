    "dataSources": {
        "ds_3adqBQSk": {
            "name": "Search_1",
            "options": {
                "extend": "ds_audit_table",
                "query": "| stats count \n| eval count = \"Total Accounts: \".count"
            },
            "type": "ds.chain"
        },
        "ds_4olH7GCc": {
            "name": "16",
            "options": {
                "query": "sourcetype=\"mscs:storage:blob:json\" index=azure category=SignInLogs \"properties.userPrincipalName\"=\"$tkn_upn2$\" | stats count by properties.networkLocationDetails{}.networkNames{} \n|  rename properties.networkLocationDetails{}.networkNames{} as Location",
                "queryParameters": {
                    "earliest": "$tkn_timerange2.earliest$",
                    "latest": "$tkn_timerange2.latest$"
                }
            },
            "type": "ds.search"
        },
        "ds_70CuizgZ": {
            "name": "7",
            "options": {
                "query": "sourcetype=\"mscs:storage:blob:json\" index=azure category=SignInLogs \"properties.userPrincipalName\"=\"$tkn_upn2$\" \n| search resultSignature!=\"SUCCESS\"\n| spath path=properties.location.geoCoordinates.latitude output=lat \n| spath path=properties.location.geoCoordinates.longitude output=lon \n| eval lat=tonumber(lat), lon=tonumber(lon) \n| geostats latfield=lat longfield=lon count",
                "queryParameters": {
                    "earliest": "$tkn_timerange2.earliest$",
                    "latest": "$tkn_timerange2.latest$"
                }
            },
            "type": "ds.search"
        },
        "ds_Ab7b6GmV": {
            "name": "13",
            "options": {
                "query": "sourcetype=\"mscs:storage:blob:json\" index=azure category=SignInLogs sourcetype=\"mscs:storage:blob:json\" index=azure category=SignInLogs | stats count by properties.deviceDetail.trustType",
                "queryParameters": {
                    "earliest": "$tkn_timerange.earliest$",
                    "latest": "$tkn_timerange.latest$"
                }
            },
            "type": "ds.search"
        },
        "ds_CXAhEneZ": {
            "name": "17",
            "options": {
                "query": "sourcetype=\"mscs:storage:blob:json\" index=azure category=SignInLogs \"properties.userPrincipalName\"=\"$tkn_upn_table$\"\n| spath path=properties.appliedConditionalAccessPolicies{} output=ca_policy_obj \n| eval ca_policy_obj=if(isnull(ca_policy_obj), \"{}\", ca_policy_obj) \n| mvexpand ca_policy_obj \n| spath input=ca_policy_obj \n| eval \"Grant Controls Enforced\" = coalesce('enforcedGrantControls{}', \"-\") \n| eval \"Session Controls Enforced\" = coalesce('enforcedSessionControls{}', \"-\") \n| rename properties.userPrincipalName AS \"UPN\" properties.appDisplayName AS Application displayName AS \"CA Policy Name\" result AS \"CA Policy Result\" \n| table _time UPN Application \"CA Policy Name\" \"Grant Controls Enforced\" \"Session Controls Enforced\" \"CA Policy Result\"",
                "queryParameters": {
                    "earliest": "$tkn_timerange.earliest$",
                    "latest": "$tkn_timerange.latest$"
                }
            },
            "type": "ds.search"
        },
        "ds_KB5XZqfL": {
            "name": "11",
            "options": {
                "query": "sourcetype=\"mscs:storage:blob:json\" index=azure category=SignInLogs sourcetype=\"mscs:storage:blob:json\" index=azure category=SignInLogs | stats count by properties.appliedConditionalAccessPolicies{}.displayName",
                "queryParameters": {
                    "earliest": "$tkn_timerange.earliest$",
                    "latest": "$tkn_timerange.latest$"
                }
            },
            "type": "ds.search"
        },
        "ds_WxpKyp4g": {
            "name": "12",
            "options": {
                "query": "sourcetype=\"mscs:storage:blob:json\" index=azure category=SignInLogs sourcetype=\"mscs:storage:blob:json\" index=azure category=SignInLogs | stats count by properties.deviceDetail.isManaged",
                "queryParameters": {
                    "earliest": "$tkn_timerange.earliest$",
                    "latest": "$tkn_timerange.latest$"
                }
            },
            "type": "ds.search"
        },
        "ds_audit_table": {
            "name": "1",
            "options": {
                "query": "sourcetype=\"mscs:storage:blob:json\" index=azure category=SignInLogs \"properties.userPrincipalName\"=\"$tkn_upn$\" properties.resourceDisplayName=\"*$tkn_resource$*\" properties.appDisplayName=\"*$tkn_application$*\" properties.authenticationDetails{}.authenticationMethod=\"*$tkn_authentication_method$*\" properties.ipAddress=\"*$tkn_ip_address$*\" properties.networkLocationDetails{}.networkNames{}=\"*$tkn_location_name$*\" properties.location.countryOrRegion=\"*$tkn_country$*\" properties.deviceDetail.isManaged=\"*$tkn_is_device_managed$*\" properties.appliedConditionalAccessPolicies{}.displayName=\"*$tkn_ca_policy_name$*\" properties.deviceDetail.trustType=\"*$tkn_device_join_type$*\" \n\n| eval auth_count = max(coalesce(mvcount('properties.authenticationDetails{}.authenticationMethod'), 0), coalesce(mvcount('properties.authenticationDetails{}.succeeded'), 0)) \n| eval auth_idx = mvrange(1, auth_count + 1) \n\n| eval \"Authentication Method\" = mvmap(auth_idx, auth_idx . \". \" . if(isnull(mvindex('properties.authenticationDetails{}.authenticationMethod', auth_idx-1)) OR mvindex('properties.authenticationDetails{}.authenticationMethod', auth_idx-1)==\"\", \"-\", mvindex('properties.authenticationDetails{}.authenticationMethod', auth_idx-1))) \n| eval \"Authentication method detail\" = mvmap(auth_idx, auth_idx . \". \" . if(isnull(mvindex('properties.authenticationDetails{}.authenticationMethodDetail', auth_idx-1)) OR mvindex('properties.authenticationDetails{}.authenticationMethodDetail', auth_idx-1)==\"\", \"-\", mvindex('properties.authenticationDetails{}.authenticationMethodDetail', auth_idx-1))) \n| eval \"Authentication Method Succeeded\" = mvmap(auth_idx, auth_idx . \". \" . if(isnull(mvindex('properties.authenticationDetails{}.succeeded', auth_idx-1)) OR mvindex('properties.authenticationDetails{}.succeeded', auth_idx-1)==\"\", \"-\", mvindex('properties.authenticationDetails{}.succeeded', auth_idx-1))) \n| eval \"Authentication Method Result Detail\" = mvmap(auth_idx, auth_idx . \". \" . if(isnull(mvindex('properties.authenticationDetails{}.authenticationStepResultDetail', auth_idx-1)) OR mvindex('properties.authenticationDetails{}.authenticationStepResultDetail', auth_idx-1)==\"\", \"-\", mvindex('properties.authenticationDetails{}.authenticationStepResultDetail', auth_idx-1))) \n\n| rename properties.userDisplayName AS User properties.userPrincipalName AS \"UPN\" properties.resourceDisplayName AS Resource properties.appDisplayName AS Application properties.clientAppUsed AS \"Client App\" properties.ipAddress AS \"IP Address\" properties.networkLocationDetails{}.networkType AS \"Network Location Type\" properties.networkLocationDetails{}.networkNames{} AS \"Location Name\" properties.location.countryOrRegion AS \"Country\" properties.location.city AS \"City\" properties.location.state AS \"State\" properties.deviceDetail.operatingSystem AS \"OS\" properties.deviceDetail.browser AS \"Browser\" properties.deviceDetail.deviceId AS \"Device ID\" properties.deviceDetail.isManaged AS \"Is Device Managed\" properties.isInteractive AS \"Is Session Interactive\" properties.deviceDetail.trustType as \"Device Join Type\" \n\n| table _time User UPN Resource Application \"Client App\" \"IP Address\" \"Network Location Type\" \"Location Name\" \"Country\" \"City\" \"State\" \"OS\" \"Browser\" \"Device ID\" \"Is Device Managed\" \"Device Join Type\" \"Is Session Interactive\" \"Authentication Method\" \"Authentication method detail\" \"Authentication Method Succeeded\" \"Authentication Method Result Detail\"",
                "queryParameters": {
                    "earliest": "$tkn_timerange.earliest$",
                    "latest": "$tkn_timerange.latest$"
                }
            },
            "type": "ds.search"
        },
        "ds_cKpy9Sfy": {
            "name": "15",
            "options": {
                "query": "sourcetype=\"mscs:storage:blob:json\" index=azure category=SignInLogs \"properties.userPrincipalName\"=\"$tkn_upn2$\" | stats count by properties.location.countryOrRegion \n|  rename properties.location.countryOrRegion as \"Country\"",
                "queryParameters": {
