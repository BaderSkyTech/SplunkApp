}, userPreferredMethodForSecondaryAuthentication,AllMethodsRegistered \n| dedup userPrincipalName \n| rename userPrincipalName as \"UPN\", userDisplayName as \"UserName\", userType as \"UserType\", isSsprRegistered as \"SSPRRegiseterd\", isSsprCapable as \"SSPRCapable\", isMfaRegistered as \"MFARegsitered\", isPasswordlessCapable as \"PasswordlessCapable\", AllMethodsRegistered as \"AllMethodsRegistered\", \"systemPreferredAuthenticationMethods{}\" as \"PreferredAuthenticationMethods\", userPreferredMethodForSecondaryAuthentication as \"PreferredMethodSecondaryAuthentication\"",
                "queryParameters": {
